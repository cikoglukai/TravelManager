{
  "$id": "envelope",
  "type": "object",
  "required": ["eventId", "tenantId", "occurredAt", "version"],
  "properties": {
    "eventId":    { "type": "string", "format": "uuid" },
    "tenantId":   { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "version":    { "type": "integer", "minimum": 1 }
  }
}
