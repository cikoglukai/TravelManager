{
  "$id": "travel.warning.published",
  "type": "object",
  "required": ["eventId", "tenantId", "occurredAt", "version", "warningId", "country", "severity", "validFrom", "source"],
  "properties": {
    "eventId":    { "type": "string", "format": "uuid" },
    "tenantId":   { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "version":    { "type": "integer", "minimum": 1 },
    "warningId":  { "type": "string" },
    "country":    { "type": "string", "minLength": 2, "maxLength": 2 },
    "region":     { "type": "string" },
    "severity":   { "type": "string", "enum": ["info", "advisory", "warning", "danger", "extreme"] },
    "validFrom":  { "type": "string", "format": "date-time" },
    "validTo":    { "type": "string", "format": "date-time" },
    "source":     { "type": "string", "enum": ["gdacs", "reliefweb", "openweather", "manual"] },
    "summary":    { "type": "string" }
  }
}
