{
  "name": "travelmanager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev":      "npm run dev --workspace=@travelmanager/bff-gateway",
    "build":    "npm run build --workspaces --if-present",
    "compose":  "docker compose up --build",
    "compose:down": "docker compose down"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
